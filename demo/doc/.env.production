# ★ 远程 API 服务器地址（由 tools/desktop 构建工具读取）
# 演示项目为独立页面，无需远程 API
VITE_REMOTE_API_URL=about:blank
# ★ 代理到远程的路径前缀，逗号分隔
VITE_PROXY_PREFIXES=/api/,/storage/
# ★ 桌面端签名请求头名称（可选，前端项目自行定义与后端约定的头名）
VITE_DESKTOP_SIGN_HEADER=X-Desktop-Signature
# ★ 桌面应用图标（从 Vue 构建产物 dist/ 目录查找）
# 各平台要求的格式不同，请分别提供对应格式的文件：
#   Linux:  PNG 格式（GTK 任务栏/窗口标题栏图标，建议 ≥ 64x64）
#   Windows: ICO 格式（EXE 资源图标，建议包含 16/32/48/64/128/256 多尺寸）
# 文件放在 public/ 目录下即可，Vite 构建时会自动复制到 dist/。
DESKTOP_ICON_LINUX=favicon.png
DESKTOP_ICON_WINDOWS=favicon.ico
